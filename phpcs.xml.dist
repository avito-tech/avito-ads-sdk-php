<?xml version="1.0"?>
<ruleset name="AvitoAds">
    <description>Стандарт кодирования PSR-12 для avito-ads/api-client.</description>
    <file>src</file>
    <file>tests</file>
    <arg name="colors"/>
    <arg value="p"/>
    <rule ref="PSR12"/>
    <ini name="memory_limit" value="256M"/>
</ruleset>
